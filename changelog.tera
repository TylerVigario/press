{% import "macros" as macros %}
{#- cocogitto 7.0.0's built-in "remote" template, except for the first release. It has no
    earlier version to differ from, so it lists no commits and links no comparison: it says
    "Initial release." and links its own release. The first release is the one with no tag
    before it: only there is from.tag unset while version.tag is set. -#}
{% if version.tag and from.tag -%}
    ## [{{ version.tag }}]({{repository_url ~ "/compare/" ~ from.tag ~ ".." ~ version.tag}}) - {{ date | date(format="%Y-%m-%d") }}
{% elif version.tag and from.id -%}
    ## [{{ version.tag }}]({{repository_url ~ "/releases/tag/" ~ version.tag}}) - {{ date | date(format="%Y-%m-%d") }}
Initial release.
{% else -%}
    {% set from = from.id -%}
    {% set to = version.id -%}

    {% set from_shorthand = from.id | truncate(length=7, end="") -%}
    {% set to_shorthand = version.id | truncate(length=7, end="") -%}

    ## Unreleased ([{{ from_shorthand ~ ".." ~ to_shorthand }}]({{repository_url ~ "/compare/" ~ from_shorthand ~ ".." ~ to_shorthand}}))
{% endif -%}
{% if from.tag or not version.tag -%}

{% for value in commits | group_by_type-%}

#### {{ value.0 | upper_first }}
{% for scope, scoped_commits in value.1 | group_by(attribute="scope") -%}
{% for commit in scoped_commits | sort(attribute="scope") -%}
{{macros::remote(commit=commit)}}
{% endfor -%}
{% endfor -%}

{% for commit in value.1 | unscoped -%}
{{macros::remote(commit=commit)}}
{% endfor -%}
{% endfor -%}
{% endif -%}
