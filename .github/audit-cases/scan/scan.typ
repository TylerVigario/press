// A stand-in for a scanned form, compiled by audit-cases.sh to scan.pdf beside this file: a full
// page, tinted to its edges, in a face press does not vendor, with a text layer of its own.
#set page(paper: "us-letter", margin: 0pt, fill: luma(225))
#set text(font: "Libertinus Serif", size: 12pt)
#pad(1in)[
  APPLICATION FORM \
  Name: #"________________________" \
  Date: #"________________________"
]
